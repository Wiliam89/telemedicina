{
  "name": "@tele/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/servidor.ts",
    "build": "tsup",
    "start": "node dist/servidor.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:banco": "node ../../scripts/testar-banco.mjs",
    "testar-fluxo": "tsx --env-file=.env src/testar-fluxo.ts",
    "demo": "tsx --env-file=.env src/demo.ts",
    "start:local": "node --env-file=.env dist/servidor.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@signpdf/placeholder-pdf-lib": "^4.0.0",
    "@signpdf/signpdf": "^4.0.0",
    "@signpdf/utils": "^4.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tele/db": "workspace:*",
    "@tele/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "node-forge": "^1.4.2",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/node-forge": "^1.3.14",
    "dotenv": "^18.0.9",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
