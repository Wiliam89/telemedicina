# =============================================================================
#  apps/web/.env.example  ->  copie para  apps/web/.env.local
#
#  O Next.js le o arquivo chamado .env.local (com ".local" no fim).
#  `pnpm configurar` cria ele para voce. `pnpm verificar` confere.
#
#  REGRA DE OURO: tudo que comeca com NEXT_PUBLIC_ e embutido no JavaScript
#  enviado ao navegador, ou seja, e PUBLICO. Por isso aqui so entram valores
#  que podem ser vistos por qualquer pessoa. A chave secreta do Supabase
#  NUNCA entra neste arquivo.
# =============================================================================


# -----------------------------------------------------------------------------
# 1) URL DO PROJETO SUPABASE  (a mesma usada na API)
#
#    Project Settings (engrenagem) > General > "Project URL"
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=


# -----------------------------------------------------------------------------
# 2) CHAVE PUBLICAVEL DO SUPABASE  (equivalente ao antigo "anon")
#
#    Esta chave pode ser vista por todo mundo. Sozinha ela nao abre nada:
#    quem decide o que ela enxerga sao as politicas RLS do banco (Modulo 4).
#
#    Onde pegar:
#      Settings > API Keys > aba "API Keys" > secao "Publishable key".
#      Atalho: https://supabase.com/dashboard/project/_/settings/api-keys/
#      Comeca com  sb_publishable_
#
#      Projeto antigo? Aba "Legacy API keys" > chave "anon" (comeca com eyJ).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# -----------------------------------------------------------------------------
# 3) ENDERECO DA NOSSA API  (apps/api)
#
#    Em desenvolvimento e o proprio computador, porta 3333.
#    Em producao sera algo como https://api.suaempresa.com.br
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3333


# -----------------------------------------------------------------------------
# 4) AMBIENTE  (tarja no topo do site)
#
#    "producao" esconde a tarja. Qualquer outro valor mostra o aviso de que
#    os documentos emitidos ali nao tem valor legal - o que evita alguem
#    levar uma receita de demonstracao a farmacia.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AMBIENTE=desenvolvimento
